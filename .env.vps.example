# .env untuk VPS (disalin ke /opt/halalpilot/.env; vps-setup.sh menurunkan /etc/halalpilot/env dan /root/.openclaw/.env dari sini).
# Nilai rahasia diisi di VPS, tidak pernah di-commit.
TZ=Asia/Jakarta
PORT=3000
BIND=127.0.0.1

# ---- Orchestrator ----
HALALPILOT_API_TOKEN=            # openssl rand -hex 24
OPENCLAW_HOOKS_URL=http://127.0.0.1:18790/hooks/agent   # 18790 = gateway kita; 18789 = gateway prainstal panitia
HOOKS_TOKEN=                     # openssl rand -hex 24 (harus sama dengan hooks.token di config OpenClaw → otomatis via template)
OPENCLAW_AGENT_ID=halalpilot
OPENROUTER_API_KEY=              # fallback vision + model cadangan
VISION_MODEL=google/gemini-2.5-flash-lite
ENABLE_INTERNAL_CRON=0           # 1 hanya jika automations OpenClaw gagal (V4)
COST_ALARM_USD_PER_DAY=2
MEM_ALARM_AVAILABLE_MB=500

# ---- Akun Telegram uji (ID numerik dari @userinfobot) ----
TG_PENDAMPING=
TG_UMK_1=
TG_UMK_2=
TG_UMK_3=
TG_PEMASOK=

# ---- OpenClaw (gateway berjalan sebagai root di VPS) ----
TELEGRAM_BOT_TOKEN=              # bot KEDUA khusus VPS (token bot lokal jangan dipakai bersamaan)
GATEWAY_TOKEN=                   # openssl rand -hex 24
DEFAULT_MODEL=openrouter/deepseek/deepseek-v3.2   # ganti dengan model default panitia jika tersedia, mis. provider/model
IMAGE_MODEL=openrouter/google/gemini-2.5-flash-lite
OPENCLAW_WORKSPACE=/root/halalpilot-workspace
# Jika model default panitia butuh API key sendiri, isi satu baris KEY=VALUE yang akan ditambahkan ke /root/.openclaw/.env, mis:
# DEFAULT_MODEL_API_KEY_LINE=IDWEBHOST_API_KEY=xxxx
DEFAULT_MODEL_API_KEY_LINE=
