# Salin ke .env (lokal) atau /etc/halalpilot/env (VPS). Jangan commit nilai asli.
TZ=Asia/Jakarta
PORT=3000
BIND=127.0.0.1
DATA_DIR=./data
PDF_DIR=./data/pdf
RULES_DIR=./rules

# Bearer yang dipakai skill OpenClaw → API (samakan dengan skills.entries.halalpilot.env.HALALPILOT_API_TOKEN)
HALALPILOT_API_TOKEN=ganti-dengan-token-acak-32-karakter

# OpenClaw hooks (dipanggil scheduler untuk mengirim pengingat/notifikasi lewat agent)
OPENCLAW_HOOKS_URL=http://127.0.0.1:18789/hooks/agent
HOOKS_TOKEN=ganti-dengan-hooks-token
OPENCLAW_AGENT_ID=halalpilot

# Fallback vision (hanya dipakai POST /products/{pid}/extract jika imageModel OpenClaw gagal, V1)
OPENROUTER_API_KEY=
VISION_MODEL=google/gemini-2.5-flash-lite

# ID Telegram numerik akun uji (ambil dari @userinfobot). Dipakai seed (tabel actor) DAN allowFrom di openclaw.json5.
TG_PENDAMPING=
TG_UMK_1=
TG_UMK_2=
TG_UMK_3=
TG_PEMASOK=

# ---------- Sisi OpenClaw (dipakai envsubst untuk ~/.openclaw/openclaw.json5 dan ~/.openclaw/.env) ----------
# Token bot dari @BotFather. Satu token hanya untuk SATU gateway (lokal ≠ VPS).
TELEGRAM_BOT_TOKEN=
# Token auth gateway OpenClaw (acak ≥ 32 karakter): openssl rand -hex 24
GATEWAY_TOKEN=
# Model utama agent. Isi dari panitia jika ada (mis. provider/model), sementara pakai DeepSeek via OpenRouter.
DEFAULT_MODEL=openrouter/deepseek/deepseek-v3.2
# Model vision untuk foto label (agents.defaults.imageModel)
IMAGE_MODEL=openrouter/google/gemini-2.5-flash-lite
# Workspace agent di mesin yang menjalankan gateway. Kosongkan untuk WSL (skrip memakai $HOME/halalpilot-workspace);
# di VPS isi /home/openclaw/halalpilot.
OPENCLAW_WORKSPACE=

# Cron internal cadangan (sweep tiap 30 menit, digest 07:00 WIB). Default 0: jadwal dipegang automations OpenClaw (openclaw/automations.sh).
ENABLE_INTERNAL_CRON=0
# Jeda dasar retry hooks (ms); tes memakai 1
HOOKS_RETRY_BASE_MS=2000

# Pengaman biaya/RAM (alarm ke admin lewat hooks)
COST_ALARM_USD_PER_DAY=2
MEM_ALARM_AVAILABLE_MB=500

# Mode demo satu akun Telegram: agent mengawali balasan dengan penanda peran, mis. [UMK · Dapur Bu Ratih]
DEMO_ROLE_BADGE=0
