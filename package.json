{
  "name": "halalpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Agent pendamping portofolio sertifikasi halal self-declare untuk UMK anggota koperasi (AI HackFest 2026, OpenClaw).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "seed:demo": "node --env-file-if-exists=.env seed/demo.mjs",
    "seed:switch": "node --env-file-if-exists=.env seed/switch-role.mjs",
    "seed:bergerak": "node --env-file-if-exists=.env seed/bergerak.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check:scenarios": "node tests/check-scenarios.mjs",
    "lint": "eslint src db seed test tests openclaw/skills"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  }
}
